{#
/**
 * @file Cards!
 *   Documenting @molecules/card/_utccard.twig
 */
#}
<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous"/>

{% embed '@demo/_demo-block.twig'
  with {
    demo: utccard_demo
  }
%}
  {% block content %}
  <h4>Cards with Button Links</h4>
    <div class="flex justify-evenly">
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_1
        } %}
      </div>
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_2
        } %}
      </div>
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_3
        } %}
      </div>
    </div>
    <hr class="my-12" />
    <h4>Cards as Links</h4>
    <div class="mt-12 clear flex justify-evenly">
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_4
        } %}
      </div>
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_5
        } %}
      </div>
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_6
        } %}
      </div>
    </div>
    <hr class="my-12" />
    <h4>Cards with Vertical Images</h4>
    <div class="mt-12 clear flex justify-evenly">
      <div class="mx-6 max-h-1/2">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_7
        } %}
      </div>
      <div class="mx-6 max-h-1/2">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_8
        } %}
      </div>
      <div class="mx-6 max-h-1/2">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_9
        } %}
      </div>
    </div>
    <hr class="my-12" />
    <h4>Cards with FontAwesome Icons</h4>
    <div class="mt-12 clear flex justify-evenly">
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_10
        } %}
      </div>
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_11
        } %}
      </div>
      <div class="mx-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_12
        } %}
      </div>
    </div>

    <hr class="my-12" />
    <h4>Cards with varying widths (only a good option with a max of 2 cards)</h4>
      <div class="my-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_13
        } %}
      </div>
      <div class="my-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_14
        } %}
      </div>
      <div class="my-6">
        {% include '@molecules/utccard/_utccard.twig' with {
          utccard: utccard_15
        } %}
      </div>

  {% endblock content %}
{% endembed %}
