{#
/**
 * @file Buttons!
 *   Documenting @atoms/button/_button.twig
 *
 */
#}

{% embed '@demo/_demo-block.twig'
  with {
    demo: buttons_demo
  }
%}
  {% block content %}
    {% include '@atoms/button/_button.twig' with {
      button: button_small
    } only %}
      {% include '@atoms/button/_button.twig' with {
      button: button_medium
    } only %}
    {% include '@atoms/button/_button.twig' with {
      button: button_large
    } only %}
    {% include '@atoms/button/_button.twig' with {
      button: button_extralarge
    } only %}
  {% endblock content %}
{% endembed %} 