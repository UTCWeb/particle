{#
/**
 * @file Buttons!
 *   Documenting @atoms/button/_button.twig
 *
 */
#}

{% embed '@demo/_demo-block.twig'
  with {
    demo: buttons_demo
  }
%}
  {% block content %}
  <div class="p-10 my-5 border-2 border-utc-new-blue-500">
  <h3 class="ml-0">Light Background</h3>
    {% include '@atoms/button/_button.twig' with {
      button: button_navy
    } only %}
      {% include '@atoms/button/_button.twig' with {
      button: button_yellow
    } only %}
    {% include '@atoms/button/_button.twig' with {
      button: button_navyoutline
    } only %}
      {% include '@atoms/button/_button.twig' with {
      button: button_lightblue
    } only %}
      {% include '@atoms/button/_button.twig' with {
      button: button_green
    } only %}
      {% include '@atoms/button/_button.twig' with {
      button: button_burgundy
    } only %}
    </div>
    <div class="bg-utc-new-blue-500 p-10">
    <h3 class="text-white ml-0">Dark Background</h3>
    {% include '@atoms/button/_button.twig' with {
      button: button_yellow
    } only %}
    {% include '@atoms/button/_button.twig' with {
      button: button_whiteoutline
    } only %}
    {% include '@atoms/button/_button.twig' with {
      button: button_lightblue
    } only %}
    {% include '@atoms/button/_button.twig' with {
      button: button_green
    } only %}
     {% include '@atoms/button/_button.twig' with {
      button: button_burgundy
    } only %}
  {% endblock content %}
{% endembed %} 