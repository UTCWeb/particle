{#
/**
 * @file
 * Theme override to display a block.
 *
 * Available variables:
 * - plugin_id: The ID of the block implementation.
 * - label: The configured label of the block if visible.
 * - configuration: A list of the block's configuration values.
 *   - label: The configured label for the block.
 *   - label_display: The display settings for the label.
 *   - provider: The module or other provider that provided this block plugin.
 *   - Block plugin specific settings will also be stored here.
 * - content: The content of this block.
 * - attributes: array of HTML attributes populated by modules, intended to
 *   be added to the main container tag of this template.
 *   - id: A valid HTML ID and guaranteed unique.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 *
 * @see template_preprocess_block()
 * 
 * This is the PL version of the block--utc-card-base.html.html.twig. NOTE: The image is currently hardcoded.
 */
#}

{% if utccard.card_type == 'wide' %}
  {% set card_orientation = 'flex flex-utccard flex-row' %}
  {% set flex_image = 'flex-utccardimg' %}
  {% set flex_body = 'flex-utccardbody' %}
{% elseif utccard.card_color == 'thumbnail' %}
  {% set card_orientation = 'flex-col' %}
{% endif %}

{#{% if utccard.card_type == 'wide' and utccard.card_icon %}
  {% set icon_size = 'wideicon' %}
{% else %}
  {% set icon_size = utccard.card_icon_size %}
{% endif %}#}

{% if utccard.card_color == 'white' %}
  {% set card_background = 'bg-white shadow-utccardwhite border-none opacity-100' %}
{% elseif utccard.card_color == 'lightblue' %}
  {% set card_background = 'bg-utc-new-blue-100 shadow-utccardwhite border-none opacity-100' %}
{% elseif utccard.card_color == 'none' %}
  {% set card_background = '' %}
{% endif %}

{% if utccard.card_width == 'none' %}
  {% set card_size = '' %}
{% elseif utccard.card_width == '50' %}
  {% set card_size = 'w-1/2' %}
{% elseif utccard.card_width == '75' %}
  {% set card_size = 'w-3/4' %}
{% elseif utccard.card_width == '100' %}
  {% set card_size = 'w-full' %}
{% else %}
  {% set card_size = '' %}
{% endif %}

{% if utccard.text_alignment == 'left' %}
  {% set card_alignment = 'text-left' %}
{% elseif utccard.text_alignment == 'center' %}
  {% set card_alignment = 'text-center' %}
{% elseif utccard.text_alignment == 'right' %}
  {% set card_alignment = 'text-right' %}
{% endif %}

{% if utccard.card_link and utccard.card_color == 'white' %}
  {% set card_link_hover = 'hover:bg-utc-new-blue-100' %}
{% elseif utccard.card_link and utccard.card_color == 'lightblue' %}
  {% set card_link_hover = 'hover:opacity-80' %}
{% elseif utccard.card_link and utccard.card_color == 'none' %}
  {% set card_link_hover = 'hover:shadow-utccardnone' %}
{% endif %}

{% if utccard.card_img_fill and not utccard.card_icon %}
  {% set image_full = 'h-full w-full object-cover' %}
{% else %}
  {% set image_full = 'p-6 flex items-center justify-center' %}
{% endif %}

{% if utccard.card_icon_color == 'blue' %}
  {% set icon_color = 'text-utc-new-blue-500' %}
{% elseif utccard.card_icon_color == 'yellow' %}
  {% set icon_color = 'text-utc-new-gold-500' %}
{% endif %}


{% if utccard.card_color == 'lightblue' and utccard.card_icon and utccard.card_icon_border %}
  {% set border_color = 'border-white' %}
{% endif %}


{% set card_classes = [
  utccard.card_type ? card_orientation,
  utccard.card_color ? card_background,
  utccard.card_width ? card_size,
  utccard.text_alignment ? card_alignment,
  utccard.card_link ? card_link_hover,
] | sort | join(' ') | trim %}

{% set icon_classes = [
  utccard.card_icon_fa ? 'fa-' ~ utccard.card_icon_fa,
  utccard.card_icon_size ? 'text-icon-' ~ utccard.card_icon_size,
  utccard.card_icon_color ? icon_color,
  utccard.card_icon_border ? 'fa-border ' ~ border_color,
] | sort | join(' ') | trim %}


{# could use include statements for items like images and buttons in design system #}
  {% if utccard.card_link %}
    <a href="{{ utccard.card_link }}" target="{{ utccard.card_link_target }}">
  {% endif %}
  

  <div class="h-full relative min-w-0 {{ card_classes }}">

    {% if (utccard.card_icon is empty) and utccard.card_image %}
      <div class="{{ flex_image }}">
        <img class="{{ image_full }}" src='{{ utccard.card_image.src }}'>
      </div>
    {% endif %}

    {% if utccard.card_icon %}
      <div class="flex text-center {{ flex_image }} justify-center">
        <div class="fontawesome-icons">
          <div class="fontawesome-icon {{ image_full }}">
            <i class="fas {{ icon_classes }}"></i>
          </div>
        </div>
      </div>
    {% endif %}

    {% block card_body %}
        <div class="p-5 h-full {{ flex_body }}">
          <div class="mb-0">
            {% if utccard.card_title %}
              <h3 class="text-xl font-semibold">{{ utccard.card_title }}
              </h3>
            {% endif %}
            <p>This card features the following:</p>
            <ul class="pl-0">
            {% if utccard.card_text %}
            <div class="mb-8">
                {% for item in utccard.card_text %}
                  <li class="py-0 my-0 block">
                    {{ item }}
                  </li>
                {% endfor %}
            </div>
            {% endif %}
             </ul>
          </div>
      
        {% if (utccard.card_link is empty) and utccard.card_button_url %}
          <div class="utc-card-2__action-container">
            <a href="{{ utccard.card_button_url }}" class="font-medium btn {{ utccard.card_button_style }}" target="{{ utccard.card_button_target }}">
              {{ utccard.card_button_text }}
           </a>
         </div>
        {% endif %}

       </div>
      {% endblock card_body %}

  </div>

  {% if utccard.card_link %}
     </a>
  {% endif %}

